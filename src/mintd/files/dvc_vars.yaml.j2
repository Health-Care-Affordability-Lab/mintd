# DVC Variables Configuration
# This file defines the executable commands for your pipeline.
# You can edit this file to match your local environment.

# Python command
python_cmd: python

# R command
r_cmd: Rscript

# Stata command
# Options: stata, stata-mp, StataMP-64.exe, etc.
# Note: the scaffolded stata stages run through a POSIX sh wrapper
# (run_stata.sh), so on Windows they need a sh-providing shell such as
# Git Bash; the executable name alone does not make the pipeline native.
stata_cmd: {{ stata_executable }}
