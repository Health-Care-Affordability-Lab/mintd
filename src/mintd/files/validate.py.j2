"""Data validation script for {{ project_name }}.

NOTE: This script runs from the code/ directory. Data paths use ../data/
"""

import json
import shutil
import sys
from pathlib import Path
from datetime import datetime
import pandas as pd

# Import mint utilities (located in same code/ directory)
from _mintd_utils import (
    ParameterAwareLogger,
    DATA_DIR,
    RAW_DIR,
    INTERMEDIATE_DIR,
    FINAL_DIR,
    get_data_paths,
    generate_data_schema,
    find_data_files,
)

# The schema step refuses column names with a digit and no letter, since a file
# without a header row has its first row there. Set True if yours are real
# names (2019, 09001); the choice is committed with this file.
ALLOW_NUMERIC_COLUMN_NAMES = False


def validate_dataset(df, dataset_name, logger):
    """Run validation checks on a dataset.

    Args:
        df: pandas DataFrame to validate
        dataset_name: Name of the dataset for logging
        logger: Logger instance

    Returns:
        dict with validation results
    """
    results = {
        "dataset": dataset_name,
        "rows": len(df),
        "columns": len(df.columns),
        "issues": [],
        "passed": True,
    }

    # Check for missing values
    missing_cols = df.columns[df.isnull().any()].tolist()
    if missing_cols:
        missing_counts = {col: int(df[col].isnull().sum()) for col in missing_cols}
        results["issues"].append({"type": "missing_values", "columns": missing_counts})

    # Check for duplicate rows
    duplicates = df.duplicated().sum()
    if duplicates > 0:
        results["issues"].append({"type": "duplicate_rows", "count": int(duplicates)})

    # Check data types
    numeric_cols = df.select_dtypes(include=["number"]).columns.tolist()
    results["numeric_columns"] = len(numeric_cols)

    # Log validation results
    logger.log(f"Validation for {dataset_name}:")
    logger.log(f"  Rows: {results['rows']}")
    logger.log(f"  Columns: {results['columns']}")
    logger.log(f"  Numeric columns: {results['numeric_columns']}")

    if results["issues"]:
        results["passed"] = False
        logger.log("  Issues found:")
        for issue in results["issues"]:
            if issue["type"] == "missing_values":
                logger.log(f"    - Missing values in: {list(issue['columns'].keys())}")
            elif issue["type"] == "duplicate_rows":
                logger.log(f"    - Found {issue['count']} duplicate rows")
    else:
        logger.log("  [OK] No issues found")

    return results


def main():
    """Main validation workflow."""
    # Initialize logging (validates directory and creates log file)
    logger = ParameterAwareLogger("validate")
    logger.log(
        "Starting data validation for {{ project_name }}...",
    )

    # Get data paths and ensure directories exist
    paths = get_data_paths()
    for name, path in paths.items():
        if name != "logs":  # logs already created by logger
            path.mkdir(parents=True, exist_ok=True)

    logger.log(f"Raw data directory: {RAW_DIR}")
    logger.log(f"Intermediate data directory: {INTERMEDIATE_DIR}")
    logger.log(f"Final data directory: {FINAL_DIR}")

    # Validate all CSV files in INTERMEDIATE_DIR
    intermediate_files = list(INTERMEDIATE_DIR.glob("*.csv"))
    # The report describes this run, not the product, so it stays out of
    # FINAL_DIR (the product's data) and its schema.
    report_file = DATA_DIR / "validation_report.json"
    # A run that stops (no data, a refused schema) must leave no report, not
    # an earlier run's: this run writes its own last.
    report_file.unlink(missing_ok=True)

    if not intermediate_files:
        # Stop, so `dvc repro` fails here and says what to do, instead of
        # writing a report and schema that describe nothing.
        no_data = "no CSV files in data/intermediate/: put .csv source files in data/raw/ and run dvc repro"
        logger.log(no_data)
        sys.exit(no_data)
    else:
        logger.log(f"Found {len(intermediate_files)} CSV files to validate")

        all_results = []
        all_valid = True

        for data_file in intermediate_files:
            df = pd.read_csv(data_file)
            results = validate_dataset(df, data_file.stem, logger)
            all_results.append(results)
            all_valid = all_valid and results["passed"]
            # The checked file ships unchanged as the product's data; a pandas
            # round-trip could change its values (leading zeros, precision).
            # Bytes only, not the mode: after `dvc repro ingest`, DVC can leave
            # the intermediate files read-only, and a copied mode would stop a
            # hand rerun from overwriting this copy. (After a full `dvc repro`,
            # data/final/ is itself read-only; rerun through `dvc repro`.)
            shutil.copyfile(data_file, FINAL_DIR / data_file.name)

        # Summary
        if all_valid:
            logger.log("[OK] All datasets passed validation")
        else:
            logger.log("[WARN] Some datasets have issues - review above")

        # Create validation report
        validation_report = {
            "status": "passed" if all_valid else "issues_found",
            "timestamp": datetime.now().isoformat(),
            "datasets": all_results,
        }

    # Generate schema from final data files
    logger.log("Generating data schema...")
    schema_dir = Path("../schemas/v1")
    schema_dir.mkdir(parents=True, exist_ok=True)
    schema_file = schema_dir / "schema.json"

    final_files = find_data_files(
        FINAL_DIR, extensions=[".csv", ".json", ".xlsx", ".xls"]
    )
    if final_files:
        # No timestamp: git keeps this file, and a rerun on unchanged data must
        # leave it unchanged.
        combined_schema = {"files": []}
        for data_file in final_files:
            try:
                file_schema = generate_data_schema(
                    data_file, allow_numeric_column_names=ALLOW_NUMERIC_COLUMN_NAMES
                )
                combined_schema["files"].append(file_schema)
                logger.log(f"  Generated schema for: {data_file.name}")
            except Exception as e:
                logger.log(
                    f"  Warning: Could not generate schema for {data_file.name}: {e}"
                )

        with open(schema_file, "w") as f:
            json.dump(combined_schema, f, indent=2, default=str)
        logger.log(f"Schema saved to: {schema_file}")
    else:
        logger.log("No data files found in FINAL_DIR for schema generation")

    with open(report_file, "w") as f:
        json.dump(validation_report, f, indent=2)
    logger.log(f"Validation report saved to: {report_file}")

    logger.log("Data validation completed successfully.")
    logger.close()


if __name__ == "__main__":
    main()
